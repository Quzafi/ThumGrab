{
  "name": "thumbgrab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ThumbGrab — free YouTube thumbnail downloader (HD, SD, all resolutions). 100% client-side.",
  "scripts": {
    "dev": "vite",
    "gen:seo": "node scripts/gen-seo.mjs",
    "prebuild": "node scripts/gen-seo.mjs",
    "build": "vite-react-ssg build",
    "build:spa": "node scripts/gen-seo.mjs && vite build",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "vite-react-ssg": "^0.9.2"
  }
}
